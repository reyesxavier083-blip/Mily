# LEYRA API — copia este archivo a .env y nunca lo subas al repositorio.
# Proveedores de IA (solo se usa la presencia de la clave; nunca se expone su valor)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Modelo local compatible con Ollama: LEYRA_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Autenticación del API para clientes externos (web/Android)
# LEYRA_API_TOKEN=

# Orígenes permitidos por CORS, separados por comas (vacío = solo mismo origen)
# LEYRA_ALLOWED_ORIGINS=https://app.leyra.example

# Datos y límites
# LEYRA_DATA_DIR=./data
# LEYRA_DEFAULT_MODEL=
# LEYRA_RATE_MAX=120
# LEYRA_MAX_UPLOAD_BYTES=20971520
