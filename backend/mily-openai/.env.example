# Required. Keep this only in the hosting provider's secret settings.
OPENAI_API_KEY=

MILY_PORT=8080
MILY_DEFAULT_MODEL=gpt-6-astra
MILY_REALTIME_MODEL=gpt-live-1

# Required for public deployment. Generate a long random value; do not commit it.
MILY_API_TOKEN=

# Comma-separated exact browser origins, no trailing slash.
# Example: https://reyesxavier083-blip.github.io
MILY_ALLOWED_ORIGINS=

# Optional OpenAI Vector Store ID; leave blank to disable File Search.
MILY_VECTOR_STORE_ID=

# Basic in-memory throttling. Resets when the process restarts.
MILY_RATE_LIMIT_WINDOW_MS=60000
MILY_RATE_LIMIT_MAX=60
